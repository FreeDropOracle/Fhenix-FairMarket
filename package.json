{
  "name": "fhenix-fairmarket",
  "private": true,
  "packageManager": "pnpm@10.0.0",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "compile": "pnpm --filter contracts compile",
    "test": "pnpm --filter contracts test",
    "test:unit": "pnpm --filter contracts test:unit",
    "test:integration": "pnpm --filter contracts test:integration",
    "coverage": "pnpm --filter contracts coverage",
    "build:keeper": "pnpm --filter keeper build",
    "test:keeper": "pnpm --filter keeper test",
    "dev:frontend": "pnpm --filter frontend dev",
    "build:frontend": "pnpm --filter frontend build",
    "test:e2e:frontend": "pnpm --filter frontend test:e2e",
    "check:frontend": "pnpm --filter frontend build && pnpm --filter frontend test:e2e"
  }
}
